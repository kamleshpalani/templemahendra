# frontend/.env.example
# Copy to .env.local for local dev — leave blank, Vite proxies /api already.

# Base URL of the PHP API.
# Leave EMPTY for both local dev and Hostinger: the frontend and the API are
# served from the same origin (public_html/ and public_html/api/), so the
# built-in "/api" default is correct.
# Only set this if you move the backend to a different host, e.g.
#   VITE_API_URL=https://api.example.com/api
VITE_API_URL=
