# .env.example — Copy to .env and fill in real values
# NEVER commit the real .env to version control

# MySQL — on Hostinger these come from hPanel → Databases → MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=templemahendra
DB_USER=your_db_username
DB_PASS=your_db_password

# Admin credentials
# Generate hash with: php -r "echo password_hash('YourPassword', PASSWORD_BCRYPT);"
ADMIN_USERNAME=admin
ADMIN_PASS_HASH=$2y$12$REPLACE_THIS_WITH_REAL_BCRYPT_HASH

# CORS — the site and API are same-origin on Hostinger, so this is only a
# safety net. Set it to your own domain rather than leaving the "*" default.
CORS_ORIGIN=https://www.templemahendra.in

# ── Site address and email ───────────────────────────────────────────────────
# Used by family registration messages, booking and donation messages, payment
# receipts and the CCAvenue return URLs.
#
# SITE_URL is the public address of the React site. Links in emails and messages
# and the addresses CCAvenue sends donors back to are built from it, so it must
# be exact, including https.
SITE_URL=https://www.templemahendra.in

# MAIL_TRANSPORT: smtp | mail | (blank)
#   smtp   speak SMTP directly to the server below. Use this on Hostinger.
#   mail   hand off to PHP's mail(). Often silently dropped by spam filters.
#   blank  write the message to backend/logs/mail.log and tell the caller that
#          email is unavailable. Useful locally. Never leave blank in production:
#          nobody can confirm an address or reset a password without email.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=no-reply@templemahendra.in
SMTP_PASS=your_mailbox_password
# tls (STARTTLS on 587) or ssl (implicit TLS on 465)
SMTP_SECURE=tls
MAIL_FROM=no-reply@templemahendra.in
MAIL_FROM_NAME=Dhabbalavaar Temple

# Google Gemini AI — chatbot (get free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza_your_key_here

# Google Places API — for Google Reviews on homepage
# Step 1: Get API key at https://console.cloud.google.com/ → APIs & Services → Credentials
#         Enable: "Places API"
# Step 2: Find your Place ID at https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
#         Search: "Dhabbalavaar Renuka Devi Lingamma Sinnammal Temple Pudupatti"
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
GOOGLE_PLACE_ID=ChIJ_YOUR_PLACE_ID_HERE

# ── Online payments (CCAvenue) ───────────────────────────────────────────────
# docs/payments/SPEC.md §4.1. Apply database/migrations/010_payments.sql first.
# Payments stay OFF until an owner turns them on in Admin → Payment Gateway, and
# PRODUCTION cannot be chosen until production credentials and PAYMENTS_SECRET
# are present. A credential set here always wins over one stored from the admin
# (the admin then shows it as "Set in the server environment").
#
# PRODUCTION checkout credentials (CCAvenue dashboard → Settings → API Keys).
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_WORKING_KEY=
# TEST credentials, issued separately by CCAvenue on request.
CCAVENUE_TEST_MERCHANT_ID=
CCAVENUE_TEST_ACCESS_CODE=
CCAVENUE_TEST_WORKING_KEY=
# Optional: a separate access code / working key for the server-to-server API
# (payment status checks and refunds). Blank = use the checkout pair above.
# CCAvenue must whitelist this server's public IP before API calls work.
CCAVENUE_API_ACCESS_CODE=
CCAVENUE_API_WORKING_KEY=
CCAVENUE_TEST_API_ACCESS_CODE=
CCAVENUE_TEST_API_WORKING_KEY=
# Optional overrides of the addresses CCAvenue returns to. Defaults:
# SITE_URL + /api/payments/ccavenue/response, /cancel and /notify. https in
# PRODUCTION, at most 100 characters. Register the same three in the dashboard.
CCAVENUE_REDIRECT_URL=
CCAVENUE_CANCEL_URL=
CCAVENUE_NOTIFY_URL=
# Tests only: send TEST mode to a mock gateway. Ignored while the mode is PRODUCTION.
CCAVENUE_TRANSACTION_URL=
CCAVENUE_API_URL=
# Signs the links in receipts, result pages and receipt QR codes. At least 32
# characters; required for PRODUCTION. Generate one with:
#   php -r "echo bin2hex(random_bytes(24));"
PAYMENTS_SECRET=
# Encrypts gateway keys stored from the admin: base64 of 32 random bytes.
# Without it the admin cannot store keys and this file is the only source.
#   php -r "echo base64_encode(random_bytes(32));"
PAYMENTS_SETTINGS_KEY=
# Development and automated tests only — never set these in production.
#   PAYMENTS_ALLOW_SIMULATOR=1   allows SIMULATOR mode, a local stand-in for CCAvenue
#   PAYMENTS_SIMULATOR_KEY       replaces the simulator's fixed, public working key
#   PAYMENTS_SETTINGS_OVERLAY    JSON object of non-secret settings for one PHP process,
#                                e.g. {"enabled":"1","mode":"simulator"}; needs the line above
PAYMENTS_ALLOW_SIMULATOR=
PAYMENTS_SIMULATOR_KEY=
PAYMENTS_SETTINGS_OVERLAY=

# ── Scheduled work ───────────────────────────────────────────────────────────
# Run the payments check every 10 minutes, and the notification worker and the
# live darshan job every minute; receipts and payment messages are sent by the
# worker.
#   */10 * * * *  /usr/bin/php /path/to/bin/payments_cron.php
#   * * * * *     /usr/bin/php /path/to/bin/notify_worker.php
#   *    * * * *  /usr/bin/php /path/to/bin/live_cron.php
# Hosts without CLI cron can call the HTTP endpoints instead, sending the key in
# the X-Cron-Key header. Each endpoint stays off (404) until its key is at least
# 24 characters (LIVE_CRON_KEY is in the live darshan block below):
#   GET /api/payments-cron   GET /api/notify-cron   GET /api/live-cron
PAYMENTS_CRON_KEY=
NOTIFY_CRON_KEY=

# ── Live darshan (YouTube Live) ──────────────────────────────────────────────
# docs/live/SPEC-PHASE1.md, SPEC-PHASE2.md, SPEC-PHASE3.md. Apply
# database/migrations/011_live_streams.sql and 012_live_automation.sql.
# Phases 1-2 need no keys: the committee pastes each broadcast's YouTube video
# id in Admin -> Live Streaming. Phase 3 lets a scheduled job follow YouTube
# instead. Everything below is optional; with none of it set nothing polls and
# the status buttons stay the only way a broadcast changes state.
#
# The zone new streams are scheduled in (default NOTIFY_TEMPLE_TZ, else Asia/Kolkata).
LIVE_TEMPLE_TZ=
# Base64 of 32 random bytes; without it the admin cannot store a YouTube
# credential and the variables below are the only source.
#   php -r "echo base64_encode(random_bytes(32));"
LIVE_SETTINGS_KEY=
# The scheduled job's HTTP trigger; /api/live-cron answers 404 until this is at
# least 24 characters.
#   php -r "echo bin2hex(random_bytes(24));"
LIVE_CRON_KEY=
# Credentials. A variable set here always wins and its field is read-only in
# the admin. YOUTUBE_API_KEY alone is enough for the whole of Phase 3; the
# OAuth trio is optional and only adds owner-only broadcast detail.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Development and automated tests only - never set these in production.
# LIVE_ALLOW_SIMULATOR=1 allows everything below it; without it all of them
# are ignored.
LIVE_ALLOW_SIMULATOR=
YOUTUBE_API_BASE_URL=
YOUTUBE_OAUTH_TOKEN_URL=
LIVE_SETTINGS_OVERLAY=
LIVE_SYNC_ONLY_TITLE_PREFIX=
LIVE_SIM_FAIL_AFTER_LIVE=
