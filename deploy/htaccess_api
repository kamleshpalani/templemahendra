# public_html/api/.htaccess
# Route all /api/* requests through the PHP router

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # /api/v1/<anything> is an alias of /api/<anything> (brief §26): index.php
  # strips the version and answers with the envelope. Sent there first, so
  # the alias keeps working even if a v1/ folder or file ever lands here.
  RewriteRule ^v1(/.*)?$ index.php [QSA,L]

  # If the exact file exists (e.g. .php endpoint), serve it
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>
