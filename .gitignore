# Files and folders to exclude from version control

# Environment secrets — never commit real values
backend/.env
backend/**/.env
frontend/.env.local
.env.local
frontend/.env.*.local
.env

# Uploaded files (manage via Hostinger, not git)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/.htaccess

# Mail fallback log — contains verification and password-reset links, which are
# credentials. The deny rule that protects it in production is kept.
backend/logs/*
!backend/logs/.htaccess

# Temporary one-off scripts (never commit DB seeds with credentials)
_seed_aiven.mjs
_seed_*.mjs
_setup_*.php

# Stray SQLite files — the app is MySQL-only, these should never come back
*.sqlite
*.sqlite3
backend/dev.sqlite
backend/sqlite_seed.php

# Legacy Render/Docker artifacts — not used on Hostinger shared hosting
Dockerfile
render.yaml
docker-entrypoint.sh

# Editor/tool scratch

# Screenshots written by the local test scripts (node tests/*.mjs). Throwaway
# evidence for one run; regenerate rather than commit.
shots/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# OS
.DS_Store
Thumbs.db
