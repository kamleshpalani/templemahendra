# STAGING ONLY. Copy to .env.node.local; never put these values in VITE_*.
# The Node backend does not load the existing PHP .env.local.
NODE_BACKEND_STAGE=staging
HOST=0.0.0.0
PORT=3000

# Use Connect > a PostgreSQL connection string from a SEPARATE staging
# Supabase project. Direct connections or the session pooler are supported.
# The password must be URL-encoded. No real credentials belong in this file.
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/postgres
DATABASE_TLS=verify-full
# If needed, download the project's CA certificate and give its local path.
DATABASE_CA_FILE=

# Only needed by npm run db:migrate. Must exactly match DATABASE_URL's host.
# Migrations require both staging mode and explicit target confirmation.
MIGRATION_CONFIRM_HOST=STAGING_HOST
